{
  "name": "simpl3-8uttons",
  "version": "1.0.0",
  "description": "Botonera multiusos programable. Saludos si lees esto!",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.luca.simpl3buttons",
    "productName": "Simpl3 8uttons",
	"asar": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icono.png"
    },
"nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!.git/**/*",
      "!*.md"
    ]
  },
  "dependencies": {
    "express": "^4.18.2",
    "obs-websocket-js": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1"
  }
}